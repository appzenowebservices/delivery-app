# Copy to .env and fill in. Never commit the real file.

# Atlas connection string (read/audit + journey arrange/cleanup)
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/dbname"

# Per-list webhook secrets: JSON map { "<listUuid>": "<secret>" }
OMNIPOST_LIST_SECRETS={"00000000-0000-4000-8000-000000000000":"changeme"}

# Confirmed list UUIDs that mean each registration type (comma-separated)
OMNIPOST_VENDOR_LIST_UUIDS=00000000-0000-4000-8000-000000000000
OMNIPOST_DELIVERY_PARTNER_LIST_UUIDS=00000000-0000-4000-8000-000000000000
OMNIPOST_AREA_MANAGER_LIST_UUIDS=00000000-0000-4000-8000-000000000000

# Webhook endpoint under test
TARGET_URL=https://admin.example.com/api/webhooks/omnipost

# ── UI test modes ───────────────────────────────────────────────────────
# dev = the locally running app, live = the deployed endpoint.
# The cockpit has a Dev/Live toggle; these define the two targets.
UI_MODE=dev
UI_DEV_URL=http://localhost:3000
UI_LIVE_URL=https://admin.example.com

# Live credentials (required for live mode; local creds come from the app's
# own .env). Leave empty until you have them — live runs will say so.
UI_LIVE_ADMIN_EMAIL=
UI_LIVE_ADMIN_PASSWORD=

# Folder of the app under test (for repo checks like devops.md).
# Default: ".." (the parent folder when the suite lives inside the app repo).
# TARGET_DIR=..
